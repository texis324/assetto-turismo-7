<UserControl x:Class="AcManager.Pages.Gt.GtSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:gt="clr-namespace:AcManager.Pages.Gt"
    FontFamily="Yu Gothic UI, Segoe UI"
    Loaded="OnLoaded" Unloaded="OnUnloaded" PreviewKeyDown="OnSettingsKeyDown" Focusable="True">
  <UserControl.Resources>
    <Style x:Key="SettingsButton" TargetType="Button">
      <Setter Property="gt:GtSfx.HandlesClickSound" Value="True" />
      <Setter Property="Foreground" Value="#EEEEF0" />
      <Setter Property="Background" Value="#303034" />
      <Setter Property="BorderBrush" Value="#535359" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20 12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Area" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Area" Property="Background" Value="#45454B" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Area" Property="BorderBrush" Value="White" /></Trigger>
              <Trigger Property="Tag" Value="pad"><Setter TargetName="Area" Property="BorderBrush" Value="White" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Area" Property="Background" Value="#62626A" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Area" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VolumeTrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" /></Border>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel Background="#141416">
    <!-- [fork] 2026-09-19: 設定画面では上の帯を出さない（以前はハンコン・パッドのタブだけ消していた）。要素は残す＝テストチャンネル等が参照する -->
    <gt:GtHeader x:Name="SettingsHeader" DockPanel.Dock="Top" Visibility="Collapsed" />
    <Border DockPanel.Dock="Top" Background="#1C1C1E" Padding="26 12">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BackButton" Content="←  戻る" Style="{StaticResource SettingsButton}"
            Background="Transparent" BorderBrush="Transparent" Padding="12 6" Click="OnBackClick" />
        <TextBlock Text="CM7 設定" FontSize="20" Foreground="#E8E8E8" Margin="22 0 0 0" VerticalAlignment="Center" />
        <Button x:Name="SoundTabButton" Content="サウンド" Margin="64 0 12 0" Padding="24 8"
            Style="{StaticResource SettingsButton}" Click="OnSoundTabClick" />
        <Button x:Name="KeyboardTabButton" Content="キーボード" Padding="24 8"
            Style="{StaticResource SettingsButton}" Click="OnKeyboardTabClick" />
        <Button x:Name="ControllerTabButton" Content="ハンコン・パッド" Padding="24 8" Margin="12 0 0 0"
            Style="{StaticResource SettingsButton}" Click="OnControllerTabClick" />
        <Button x:Name="DisplayTabButton" Content="表示・振動" Padding="24 8" Margin="12 0 0 0"
            Style="{StaticResource SettingsButton}" Click="OnDisplayTabClick" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="40 16" BorderBrush="#303034" BorderThickness="0 1 0 0">
      <DockPanel>
        <TextBlock x:Name="HintBack" DockPanel.Dock="Right" Text="Esc  戻る" Foreground="#B4B4BC" />
        <TextBlock x:Name="SaveNote" Text="変更は自動的に保存されます" Foreground="#9999A3" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <!-- Add only the settings CM7 needs, one section at a time. -->
    <Grid>
    <ContentControl x:Name="ControllerPanel" Visibility="Collapsed" />
    <!-- 表示: タイトル画面と既存のオープニングムービー -->
    <ScrollViewer x:Name="DisplayPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="40 36" MaxWidth="1040" HorizontalAlignment="Stretch">
        <TextBlock Text="表示" Foreground="White" FontSize="26" Margin="0 0 0 22" />
        <!-- [fork] 2026-10-11 要望「振動を設定画面でオンオフできるように」: pad.txt の bridge_rumble を書き換える -->
        <Border Background="#242427" CornerRadius="6" Padding="30 28" Margin="0 0 0 18">
          <StackPanel>
            <Grid Margin="0 0 0 16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="コントローラーの振動" Foreground="#F5F5F6" FontSize="21" />
                <TextBlock Text="走行中、縁石やタイヤの滑りなどを DS4 の振動で伝えます。走行中に切り替えても数秒で反映されます。"
                    Foreground="#A9A9B3" FontSize="14" Margin="0 8 12 0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="RumbleStateText" Grid.Column="1" Foreground="White" FontSize="26" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel>
              <Button x:Name="RumbleOnButton" Content="オン" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 12 10" Click="OnRumbleOnClick" />
              <Button x:Name="RumbleOffButton" Content="オフ" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 0 10" Click="OnRumbleOffClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="#242427" CornerRadius="6" Padding="30 28">
          <StackPanel>
            <Grid Margin="0 0 0 16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="タイトル画面" Foreground="#F5F5F6" FontSize="21" />
                <TextBlock Text="起動時に ASSETTO TURISMO のタイトル画面を表示します。表示しない場合は直接ワールドマップへ進みます。変更は次回起動から反映されます。"
                    Foreground="#A9A9B3" FontSize="14" Margin="0 8 12 0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="TitleScreenStateText" Grid.Column="1" Foreground="White" FontSize="26" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel>
              <Button x:Name="TitleScreenOnButton" Content="表示する" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 12 10" Click="OnTitleScreenOnClick" />
              <Button x:Name="TitleScreenOffButton" Content="表示しない" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 0 10" Click="OnTitleScreenOffClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="#242427" CornerRadius="6" Padding="30 28" Margin="0 18 0 0">
          <StackPanel>
            <Grid Margin="0 0 0 16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="オープニングムービー" Foreground="#F5F5F6" FontSize="21" />
                <TextBlock Text="CM7 の起動時にオープニングムービーを再生します。再生中は何かキーを押すとスキップできます。"
                    Foreground="#A9A9B3" FontSize="14" Margin="0 8 12 0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="OpeningStateText" Grid.Column="1" Foreground="White" FontSize="26" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="OpeningMissingNote" Text="動画ファイルが見つかりません（Data\Static\gt7\opening.mp4）。"
                Foreground="#E9BC7F" Visibility="Collapsed" TextWrapping="Wrap" Margin="0 0 0 12" />
            <WrapPanel>
              <Button x:Name="OpeningOnButton" Content="再生する" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 12 10" Click="OnOpeningOnClick" />
              <Button x:Name="OpeningOffButton" Content="再生しない" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 12 10" Click="OnOpeningOffClick" />
              <Button x:Name="OpeningPlayButton" Content="今すぐ見る" Style="{StaticResource SettingsButton}" Background="Transparent" Padding="24 8" Margin="0 0 0 10" Click="OnOpeningPlayClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <!-- 起動時のロゴ演出（黒→ロゴ→黒→ムービー）。オフなら起動が少し速い -->
        <Border Background="#242427" CornerRadius="6" Padding="30 28" Margin="0 18 0 0">
          <StackPanel>
            <Grid Margin="0 0 0 16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="起動時のロゴ演出" Foreground="#F5F5F6" FontSize="21" />
                <TextBlock Text="起動時にロゴを映してからムービーへ入ります（約5秒）。オフにすると起動が少し速くなります。"
                    Foreground="#A9A9B3" FontSize="14" Margin="0 8 12 0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="IntroStateText" Grid.Column="1" Foreground="White" FontSize="26" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel>
              <Button x:Name="IntroOnButton" Content="表示する" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 12 10" Click="OnIntroOnClick" />
              <Button x:Name="IntroOffButton" Content="表示しない" Style="{StaticResource SettingsButton}" Padding="24 8" Margin="0 0 12 10" Click="OnIntroOffClick" />
              <Button x:Name="IntroPlayButton" Content="演出を確認" Style="{StaticResource SettingsButton}" Background="Transparent" Padding="24 8" Margin="0 0 0 10" Click="OnIntroPlayClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <!-- ムービーと演出の音量 -->
        <Border Background="#242427" CornerRadius="6" Padding="30 28" Margin="0 18 0 0">
          <StackPanel>
            <Grid Margin="0 0 0 14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="ムービーの音量" Foreground="#F5F5F6" FontSize="21" />
                <TextBlock Text="オープニングムービーとロゴ演出の音量（目盛りは聴こえ方に合わせたカーブ。小さめの音量も細かく選べます）" Foreground="#A9A9B3" FontSize="14" Margin="0 8 12 0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="MovieVolumeText" Grid.Column="1" Foreground="White" FontSize="30" VerticalAlignment="Center" />
            </Grid>
            <Border x:Name="MovieVolumeRow" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <Button x:Name="MovieVolumeDecreaseButton" Content="−" AutomationProperties.Name="ムービーの音量を5％下げる" FontSize="20"
                    Style="{StaticResource SettingsButton}" Padding="0 8" Click="OnMovieVolumeDecreaseClick" />
                <Slider x:Name="MovieVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="20 0" VerticalAlignment="Center" Height="44"
                    Template="{Binding Template, ElementName=VolumeSlider}" AutomationProperties.Name="ムービーの音量（％）"
                    gt:GtSfx.HandlesClickSound="True" Cursor="Hand" ValueChanged="OnMovieVolumeChanged"
                    PreviewMouseLeftButtonUp="OnMovieVolumeReleased" PreviewKeyUp="OnMovieVolumeKeyUp" />
                <Button x:Name="MovieVolumeIncreaseButton" Grid.Column="2" Content="＋" AutomationProperties.Name="ムービーの音量を5％上げる" FontSize="20"
                    Style="{StaticResource SettingsButton}" Padding="0 8" Click="OnMovieVolumeIncreaseClick" />
              </Grid>
            </Border>
            <Grid Margin="80 2 80 26">
              <TextBlock Text="0％（消音）" Foreground="#90909B" FontSize="12" />
              <TextBlock Text="100％" Foreground="#90909B" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
            <WrapPanel>
              <Button x:Name="MovieVolumePreviewButton" Content="音を確認" Style="{StaticResource SettingsButton}" Margin="0 0 12 10" Click="OnMovieVolumePreviewClick" />
              <Button x:Name="MovieVolumeResetButton" Content="初期値に戻す（60％）" Style="{StaticResource SettingsButton}" Background="Transparent" Margin="0 0 0 10" Click="OnMovieVolumeResetClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="SoundPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="40 36" MaxWidth="1040" HorizontalAlignment="Stretch">
        <TextBlock Text="サウンド" Foreground="White" FontSize="26" Margin="0 0 0 22" />
        <!-- [fork] 全体音量: クリック音・オープニング・BGM に共通で掛かるマスター（2026-10-04） -->
        <Border Background="#242427" CornerRadius="6" Padding="30 28">
          <StackPanel>
            <Grid Margin="0 0 0 14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="全体音量" Foreground="#F5F5F6" FontSize="21" />
                <TextBlock Text="クリック音・オープニング・BGM をまとめて上げ下げします（下の個別の音量はそのままで、これを掛け算します。走行中の音は対象外）" Foreground="#A9A9B3" FontSize="14" Margin="0 8 12 0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="MasterVolumeText" Grid.Column="1" Foreground="White" FontSize="30" VerticalAlignment="Center" />
            </Grid>
            <Border x:Name="MasterVolumeRow" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <Button x:Name="MasterVolumeDecreaseButton" Content="−" AutomationProperties.Name="全体音量を5％下げる" FontSize="20"
                    Style="{StaticResource SettingsButton}" Padding="0 8" Click="OnMasterVolumeDecreaseClick" />
                <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="20 0" VerticalAlignment="Center" Height="44"
                    Template="{Binding Template, ElementName=VolumeSlider}" AutomationProperties.Name="全体音量（％）"
                    gt:GtSfx.HandlesClickSound="True" Cursor="Hand" ValueChanged="OnMasterVolumeChanged"
                    PreviewMouseLeftButtonUp="OnMasterVolumeReleased" PreviewKeyUp="OnMasterVolumeKeyUp" />
                <Button x:Name="MasterVolumeIncreaseButton" Grid.Column="2" Content="＋" AutomationProperties.Name="全体音量を5％上げる" FontSize="20"
                    Style="{StaticResource SettingsButton}" Padding="0 8" Click="OnMasterVolumeIncreaseClick" />
              </Grid>
            </Border>
            <Grid Margin="80 2 80 26">
              <TextBlock Text="0％（消音）" Foreground="#90909B" FontSize="12" />
              <TextBlock Text="100％" Foreground="#90909B" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
            <WrapPanel>
              <Button x:Name="MasterVolumePreviewButton" Content="音を確認" Style="{StaticResource SettingsButton}" Margin="0 0 12 10" Click="OnMasterVolumePreviewClick" />
              <Button x:Name="MasterVolumeResetButton" Content="初期値に戻す（100％）" Style="{StaticResource SettingsButton}" Background="Transparent" Margin="0 0 0 10" Click="OnMasterVolumeResetClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="#242427" CornerRadius="6" Padding="30 28" Margin="0 18 0 0">
          <StackPanel>
            <Grid Margin="0 0 0 14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="クリック音" Foreground="#F5F5F6" FontSize="21" />
                <TextBlock Text="決定・戻る・選択移動の音量（目盛りは聴こえ方に合わせたカーブ。小さめの音量も細かく選べます）" Foreground="#A9A9B3" FontSize="14" Margin="0 8 12 0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="VolumeText" Grid.Column="1" Foreground="White" FontSize="30" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="DisabledNote" Text="操作音が無効になっています。音量は保存されますが、試聴は鳴りません。"
                Foreground="#E9BC7F" Visibility="Collapsed" TextWrapping="Wrap" Margin="0 0 0 12" />
            <Border x:Name="VolumeRow" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <Button x:Name="DecreaseButton" Content="−" AutomationProperties.Name="クリック音を1％下げる" FontSize="20"
                    Style="{StaticResource SettingsButton}" Padding="0 8" Click="OnDecreaseClick" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="20 0" VerticalAlignment="Center" Height="44"
                    AutomationProperties.Name="クリック音の音量（％）" gt:GtSfx.HandlesClickSound="True" Cursor="Hand" ValueChanged="OnVolumeChanged"
                    PreviewMouseLeftButtonUp="OnVolumeReleased" PreviewKeyUp="OnVolumeKeyUp">
                  <Slider.Template><ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                      <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource VolumeTrackButton}" Background="#EEEEF2" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="18" Height="28">
                          <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#FFFFFF" CornerRadius="3" /></ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource VolumeTrackButton}" Background="#56565E" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                      </Track>
                      <Border x:Name="FocusRing" BorderBrush="White" BorderThickness="1" CornerRadius="3" Margin="-6 0" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate></Slider.Template>
                </Slider>
                <Button x:Name="IncreaseButton" Grid.Column="2" Content="＋" AutomationProperties.Name="クリック音を1％上げる" FontSize="20"
                    Style="{StaticResource SettingsButton}" Padding="0 8" Click="OnIncreaseClick" />
              </Grid>
            </Border>
            <Grid Margin="80 2 80 26">
              <TextBlock Text="0％（消音）" Foreground="#90909B" FontSize="12" />
              <TextBlock Text="100％" Foreground="#90909B" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
            <WrapPanel>
              <Button x:Name="PreviewButton" Content="音を確認" Style="{StaticResource SettingsButton}" Margin="0 0 12 10" Click="OnPreviewClick" />
              <Button x:Name="ResetButton" Content="初期値に戻す（35％）" Style="{StaticResource SettingsButton}" Background="Transparent" Margin="0 0 0 10" Click="OnResetClick" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="KeyboardPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="40 30" MaxWidth="1040" HorizontalAlignment="Stretch">
        <TextBlock Text="キーボード" Foreground="White" FontSize="26" Margin="0 0 0 18" />
        <TextBlock x:Name="DrivingNote" Text="走行を終了すると、アシストとキー割り当てを変更できます。"
            Foreground="#E9BC7F" Visibility="Collapsed" Margin="0 0 0 16" TextWrapping="Wrap" />
        <StackPanel x:Name="KeyboardEditor">
          <Border Background="#242427" CornerRadius="6" Padding="30 22" Margin="0 0 0 18">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="切り返しアシスト" Foreground="#F5F5F6" FontSize="21" />
                  <TextBlock Text="車速に合わせて切れ幅を抑え、左右の切り返しをなめらかにします。"
                      Foreground="#A9A9B3" FontSize="14" Margin="0 6 12 0" TextWrapping="Wrap" />
                  <TextBlock Text="アクセルとブレーキの押し始めも穏やかになります。"
                      Foreground="#A9A9B3" FontSize="14" Margin="0 3 12 0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="AssistText" Grid.Column="1" Foreground="White" FontSize="26" VerticalAlignment="Center" />
              </Grid>
              <Border x:Name="AssistRow" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="10 2" Margin="0 16 0 8">
                <Slider x:Name="AssistSlider" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Height="44" Margin="6 0"
                    Template="{Binding Template, ElementName=VolumeSlider}" AutomationProperties.Name="切り返しアシストの強さ（％）"
                    gt:GtSfx.HandlesClickSound="True" Cursor="Hand" ValueChanged="OnAssistChanged"
                    PreviewMouseLeftButtonUp="OnAssistReleased" PreviewKeyUp="OnAssistKeyUp" />
              </Border>
              <WrapPanel>
                <Button x:Name="LegacyAssistButton" Content="従来の操作（0％）" Tag="0" Style="{StaticResource SettingsButton}" Padding="18 8" Margin="0 0 12 0" Click="OnAssistPresetClick" />
                <Button x:Name="NormalAssistButton" Content="標準（50％）" Tag="50" Style="{StaticResource SettingsButton}" Padding="18 8" Margin="0 0 12 0" Click="OnAssistPresetClick" />
                <Button x:Name="StrongAssistButton" Content="強め（100％）" Tag="100" Style="{StaticResource SettingsButton}" Padding="18 8" Click="OnAssistPresetClick" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="#242427" CornerRadius="6" Padding="30 22">
            <StackPanel>
              <TextBlock Text="キー割り当て" Foreground="#F5F5F6" FontSize="21" />
              <TextBlock Text="右のボタンを選び、割り当てたいキーを押してください。Escで取り消せます。"
                  Foreground="#A9A9B3" FontSize="14" Margin="0 6 0 14" TextWrapping="Wrap" />
              <StackPanel x:Name="BindingsPanel" />
              <Button x:Name="ResetBindingsButton" Content="元の割り当てに戻す" HorizontalAlignment="Left" Background="Transparent"
                  Style="{StaticResource SettingsButton}" Margin="0 16 0 0" Padding="18 8" Click="OnResetBindingsClick" />
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock x:Name="KeyboardStatus" Foreground="#E9BC7F" FontSize="14" Margin="0 14 0 0" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
