<Window x:Class="AcManager.Pages.Gt.GtOpeningWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Opening" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="#000000" AllowsTransparency="False"
    Topmost="True" ShowActivated="True" Focusable="True" Cursor="None" FontFamily="Yu Gothic UI, Segoe UI">
  <Grid Background="#000000">
    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="False"
        IsMuted="False" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
    <!-- 起動時のロゴ演出（黒地にロゴ画像をフェードイン→わずかに縮む→フェードアウト） -->
    <Image x:Name="IntroImage" Stretch="Uniform" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
        RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform><ScaleTransform x:Name="IntroScale" ScaleX="1.04" ScaleY="1.04" /></Image.RenderTransform>
    </Image>
    <!-- 黒からフェードイン／黒へフェードアウト用（Window.Opacity は AllowsTransparency 無しでは効かない） -->
    <Rectangle x:Name="Fade" Fill="#000000" Opacity="1" IsHitTestVisible="False" />
    <TextBlock x:Name="Hint" Text="何かキーを押すとスキップ" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 48 30"
        FontFamily="Bahnschrift SemiCondensed, Yu Gothic UI" FontSize="13" Foreground="#D4B474" Opacity="0" IsHitTestVisible="False" />
  </Grid>
</Window>
