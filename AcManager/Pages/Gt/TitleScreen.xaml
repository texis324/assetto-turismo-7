<UserControl x:Class="AcManager.Pages.Gt.TitleScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gt="clr-namespace:AcManager.Pages.Gt"
    Loaded="OnLoaded" Unloaded="OnUnloaded" PreviewKeyDown="OnPreviewKeyDown"
    FontFamily="Yu Gothic UI, Segoe UI" Foreground="White" Background="#03060B"
    Focusable="True" FocusVisualStyle="{x:Null}" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#18000000" />
      <Setter Property="BorderBrush" Value="#DAFFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" CornerRadius="36" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#60FFFFFF" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="#60FFFFFF" /></Trigger>
              <Trigger Property="gt:TitleScreen.IsPadFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="#60FFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#90FFFFFF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.58" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style x:Key="NewsCard" TargetType="Button">
      <Setter Property="Width" Value="292" />
      <Setter Property="Height" Value="272" />
      <Setter Property="Margin" Value="0,0,20,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#6205070C" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" CornerRadius="6" ClipToBounds="True" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White" /><Setter TargetName="Frame" Property="Background" Value="#BD17202C" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White" /></Trigger>
              <Trigger Property="gt:TitleScreen.IsPadFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White" /><Setter TargetName="Frame" Property="Background" Value="#BD17202C" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- The cover fills the window; the controls keep their proportions and remain fully visible. -->
  <Grid x:Name="TitleRoot" ClipToBounds="True">
        <Image x:Name="CoverImage" Stretch="UniformToFill" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Source="../../Assets/GtTitle/background.png" RenderOptions.BitmapScalingMode="HighQuality" />
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2602050A" Offset="0" />
            <GradientStop Color="#0002050A" Offset="0.38" />
            <GradientStop Color="#2902050A" Offset="0.52" />
            <GradientStop Color="#7802050A" Offset="0.7" />
            <GradientStop Color="#E002050A" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
  <Viewbox Stretch="Uniform" StretchDirection="Both">
    <Grid x:Name="Stage" Width="1920" Height="1080" ClipToBounds="True">
      <Canvas x:Name="ControlsLayer">
        <StackPanel Canvas.Left="44" Canvas.Top="25" Orientation="Horizontal" VerticalAlignment="Center">
          <Border BorderBrush="#B8FFFFFF" BorderThickness="1.5" CornerRadius="4" Padding="8,3">
            <TextBlock Text="CM7" FontSize="17" FontWeight="SemiBold" />
          </Border>
          <TextBlock x:Name="VersionText" Margin="13,5,0,0" FontSize="15" Opacity="0.9" Text="ASSETTO TURISMO" />
        </StackPanel>
        <StackPanel Canvas.Right="30" Canvas.Top="17" Orientation="Horizontal">
          <TextBlock Text="ASSETTO TURISMO" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="0,0,18,0" />
          <Rectangle Width="1" Height="22" Fill="#9AFFFFFF" Margin="0,0,9,0" />
          <Button x:Name="SettingsButton" Style="{StaticResource QuietButton}" Click="OnSettings" ToolTip="設定" AutomationProperties.Name="設定">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="24" />
          </Button>
          <Button x:Name="ExitButton" Style="{StaticResource QuietButton}" Click="OnExit" ToolTip="終了" AutomationProperties.Name="終了">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="24" />
          </Button>
        </StackPanel>

        <Button x:Name="AnnouncementButton" Canvas.Left="370" Canvas.Top="496" Width="1180" Height="46"
            Style="{StaticResource QuietButton}" Click="OnAnnouncement">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="22" Margin="0,1,14,0" />
            <TextBlock Text="ASSETTO TURISMO へようこそ。クルマを愛する、すべての人へ。" FontSize="21" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <Button x:Name="WorldMapButton" Canvas.Left="600" Canvas.Top="574" Width="348" Height="68"
            Style="{StaticResource TitleButton}" Click="OnWorldMap" Content="ワールドマップ">
          <Button.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#58FFFFFF" Offset="0" /><GradientStop Color="#28000000" Offset="1" />
            </LinearGradientBrush>
          </Button.Background>
        </Button>
        <Button x:Name="MusicRallyButton" Canvas.Left="976" Canvas.Top="574" Width="348" Height="68"
            Style="{StaticResource TitleButton}" Content="ミュージックラリー" IsEnabled="False"
            ToolTip="ミュージックラリーは準備中です" ToolTipService.ShowOnDisabled="True" />

        <ScrollViewer x:Name="NewsScroller" Canvas.Left="92" Canvas.Top="704" Width="1728" Height="278"
            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
            CanContentScroll="False" PanningMode="HorizontalOnly">
          <StackPanel x:Name="CardsPanel" Orientation="Horizontal" />
        </ScrollViewer>
        <Button x:Name="PreviousButton" Canvas.Left="24" Canvas.Top="798" Width="58" Height="68"
            Style="{StaticResource QuietButton}" Click="OnPrevious" ToolTip="前のお知らせ" AutomationProperties.Name="前のお知らせ" Content="&#x2039;" FontSize="44" />
        <Button x:Name="NextButton" Canvas.Left="1834" Canvas.Top="798" Width="58" Height="68"
            Style="{StaticResource QuietButton}" Click="OnNext" ToolTip="次のお知らせ" AutomationProperties.Name="次のお知らせ" Content="&#x203A;" FontSize="44" />

        <Grid Canvas.Left="0" Canvas.Top="1000" Width="1920">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="NewsButton" Style="{StaticResource QuietButton}" Click="OnNews" Margin="0,0,18,0">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Margin="0,2,9,0" /><TextBlock Text="お知らせ" /></StackPanel>
          </Button>
          <Button x:Name="GuideButton" Style="{StaticResource QuietButton}" Click="OnGuide" Margin="0,0,18,0">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82D;" Margin="0,2,9,0" /><TextBlock Text="操作ガイド" /></StackPanel>
          </Button>
          <Button x:Name="OpeningButton" Style="{StaticResource QuietButton}" Click="OnOpening">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" Margin="0,2,9,0" /><TextBlock Text="オープニング" /></StackPanel>
          </Button>
        </StackPanel>
        </Grid>
      </Canvas>

      <Grid x:Name="InfoOverlay" Visibility="Collapsed" Background="#CF02050A"
          KeyboardNavigation.TabNavigation="Cycle">
        <Border Width="760" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#F2181D26"
            BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="12" Padding="46,40">
          <StackPanel>
            <TextBlock x:Name="InfoTitle" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Rectangle Height="1" Fill="#50FFFFFF" Margin="0,22,0,25" />
            <TextBlock x:Name="InfoText" FontSize="22" LineHeight="36" TextWrapping="Wrap" />
            <Button x:Name="CloseInfoButton" Style="{StaticResource TitleButton}" Width="240" Height="58"
                Margin="0,34,0,0" Content="閉じる" Click="OnCloseInfo" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Viewbox>
  </Grid>
</UserControl>
