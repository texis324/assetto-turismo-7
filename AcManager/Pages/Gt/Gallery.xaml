<UserControl x:Class="AcManager.Pages.Gt.Gallery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI"
    xmlns:gt="clr-namespace:AcManager.Pages.Gt"
    Loaded="OnLoaded" Unloaded="OnUnloaded" FocusVisualStyle="{x:Null}" Focusable="True" PreviewKeyDown="OnKeyDown"
    FontFamily="Yu Gothic UI, Segoe UI">
  <!-- [fork] スケープス（写真ギャラリー）: 撮った写真と手持ちの画像を GT7 風グリッドで展示。クリックで全画面 -->
  <DockPanel Background="#0A0A0D">
    <gt:GtHeader DockPanel.Dock="Top" />

    <Grid DockPanel.Dock="Top" Height="54">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="34 0 0 0">
        <TextBlock Text="スケープス" FontFamily="Bahnschrift SemiBold, Yu Gothic UI" FontSize="22" Foreground="#F0F0F2" VerticalAlignment="Center" />
        <TextBlock x:Name="CountText" Text="" FontSize="13" Foreground="#8A8A90" VerticalAlignment="Center" Margin="26 4 0 0" />
      </StackPanel>
      <!-- [fork] パッド操作中は ○ / × 表記へ（コンストラクタで GtHints.Bind） -->
      <TextBlock x:Name="HintBack" Text="Esc  戻る" FontSize="13" Foreground="#8A8A90" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 34 0" />
    </Grid>

    <Grid>
      <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="24 6 24 28"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="#141418" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="3">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#F0F0F2" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#F0F0F2" />
                      <Setter TargetName="Bd" Property="Background" Value="#303038" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Width="324" Height="182">
              <mui:BetterImage Filename="{Binding Path}" DecodeWidth="360" Stretch="UniformToFill" ClipToBounds="True" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="展示できる写真がありません" FontSize="20" Foreground="#C8C8CC" HorizontalAlignment="Center" />
        <TextBlock x:Name="HintPath" Text="" FontSize="12.5" Foreground="#8A8A90" HorizontalAlignment="Center" Margin="0 14 0 0" TextAlignment="Center" LineHeight="22" />
      </StackPanel>

      <!-- 全画面ビューア -->
      <Grid x:Name="Viewer" Visibility="Collapsed" Background="#F2050608" MouseLeftButtonUp="OnViewerClick">
        <Image x:Name="ViewerImage" Stretch="Uniform" Margin="40" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="ViewerCaption" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 22"
            FontSize="12.5" Foreground="#9A9AA2" />
        <TextBlock x:Name="HintViewer" Text="← →  送る    クリック / Esc  閉じる" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 18 0 0"
            FontSize="12" Foreground="#6A6A72" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
