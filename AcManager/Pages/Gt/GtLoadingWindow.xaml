<Window x:Class="AcManager.Pages.Gt.GtLoadingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI"
    Title="Loading" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="#000000" AllowsTransparency="False"
    FontFamily="Yu Gothic UI, Segoe UI" Cursor="None">
  <Window.Resources>
    <SolidColorBrush x:Key="GtGold" Color="#D4B474" />
    <SolidColorBrush x:Key="GtIvory" Color="#E8E6E1" />
    <FontFamily x:Key="GtHead">Bahnschrift Light SemiCondensed, Yu Gothic UI Light</FontFamily>
    <FontFamily x:Key="GtNum">Bahnschrift SemiCondensed, Yu Gothic UI</FontFamily>
  </Window.Resources>
  <Grid Background="#000000">
    <Grid.RowDefinitions>
      <RowDefinition Height="9*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="7*" />
    </Grid.RowDefinitions>

    <!-- 中央やや上: コースのロゴ（無ければコース図＋名前） -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
      <Image x:Name="LoadLogo" MaxHeight="250" MaxWidth="820" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
      <StackPanel x:Name="LoadTextBlock" HorizontalAlignment="Center">
        <Image x:Name="LoadOutline" Height="120" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9" Margin="0 0 0 18" />
        <TextBlock x:Name="LoadTrackName" Text="" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource GtHead}" FontSize="64"
            Foreground="{StaticResource GtIvory}" TextWrapping="Wrap" MaxWidth="1300" />
      </StackPanel>
      <TextBlock x:Name="LoadTrackSub" Text="" HorizontalAlignment="Center" FontFamily="{StaticResource GtNum}" FontSize="16" Foreground="{StaticResource GtGold}" Margin="0 14 0 0" />
    </StackPanel>

    <!-- 中央: 車のガレージ画像＋名前 -->
    <StackPanel Grid.Row="3" HorizontalAlignment="Center">
      <Border Width="440" Height="248" Background="#14FFFFFF" CornerRadius="3" ClipToBounds="True">
        <Image x:Name="LoadCarImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
      <TextBlock x:Name="LoadCarBrand" Text="" HorizontalAlignment="Center" FontFamily="{StaticResource GtNum}" FontSize="13" Foreground="{StaticResource GtGold}" Margin="0 12 0 0" />
      <TextBlock x:Name="LoadCarName" Text="" HorizontalAlignment="Center" FontFamily="{StaticResource GtHead}" FontSize="30" Foreground="{StaticResource GtIvory}" />
    </StackPanel>

    <!-- 中央より下: 白いスピナー＋一言 -->
    <StackPanel Grid.Row="5" HorizontalAlignment="Center">
      <mui:ModernProgressRing x:Name="LoadSpinner" IsActive="True" Width="44" Height="44" Foreground="#FFFFFF" HorizontalAlignment="Center" />
      <TextBlock x:Name="LoadStatus" Text="ロード中" HorizontalAlignment="Center" FontFamily="{StaticResource GtNum}" FontSize="14" Foreground="{StaticResource GtIvory}" Opacity="0.7" Margin="0 14 0 0" />
    </StackPanel>

    <TextBlock Grid.Row="6" Text="Esc  幕を下ろす" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="64 0 0 22" FontFamily="{StaticResource GtNum}" FontSize="11"
        Foreground="{StaticResource GtGold}" Opacity="0.3" />
  </Grid>
</Window>
