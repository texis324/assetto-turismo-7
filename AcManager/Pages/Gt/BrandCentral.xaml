<UserControl x:Class="AcManager.Pages.Gt.BrandCentral" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:gt="clr-namespace:AcManager.Pages.Gt"
    xmlns:c="clr-namespace:AcManager.Controls;assembly=AcManager.Controls"
    mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
    Focusable="True" KeyDown="OnKeyDown" FontFamily="Yu Gothic UI, Segoe UI">
  <UserControl.Resources>
    <!-- [fork] GT7 ブランドセントラル実測配色
         gt7-ref/garage/ref_5_brand_central_maker_grid.jpg  … 暗いショールーム(ぼかし)の上に白いメーカーロゴ 5 列・左に地域の縦タブ
         gt7-ref/garage/ref_4_brand_central_car_detail.jpg  … 左=大きなロゴ・中=車・右=国旗/メーカー/車名/PP ピル/スペック表・下=車の帯
         面 #141416 / ラベル #8A8A8A / 値 #F0F0F0 / 罫線 #4A4C54 / 強調=青 #58A6F0 / 所有印=金 #D4B474 -->
    <SolidColorBrush x:Key="GtBg" Color="#141416" />
    <SolidColorBrush x:Key="GtLabel" Color="#8A8A8A" />
    <SolidColorBrush x:Key="GtValue" Color="#F0F0F0" />
    <SolidColorBrush x:Key="GtHair" Color="#4A4C54" />
    <SolidColorBrush x:Key="GtBlue" Color="#58A6F0" />
    <SolidColorBrush x:Key="GtGold" Color="#D4B474" />
    <FontFamily x:Key="GtNum">Bahnschrift SemiCondensed, Yu Gothic UI</FontFamily>
    <FontFamily x:Key="GtBody">Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="GtGlyph">Segoe UI Emoji, Segoe UI Symbol</FontFamily>
  </UserControl.Resources>

  <Grid Background="{StaticResource GtBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- GT7共通ヘッダーバー（原則: 施設内は常にヘッダー） -->
    <gt:GtHeader x:Name="Header" Grid.Row="0" />

    <Grid Grid.Row="1" ClipToBounds="True">
      <!-- 背景: ぼかしたショールーム（Static\gt7\brandcentral.jpg・無ければ面の色だけ） -->
      <Image x:Name="BgImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
      <Rectangle x:Name="BgShade" Fill="#6A000000" />

      <!-- ══ ① メーカー選択（左=地域の縦タブ / 右=国ごとの段：国旗・国名＋その国のメーカー。2026-09-27） ══ -->
      <Grid x:Name="BrandsView">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="RegionRail" Grid.Column="0" Margin="44 44 0 0" />
        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="46 0 0 52">
          <TextBlock Text="ガレージ" FontSize="11.5" Foreground="{StaticResource GtLabel}" />
          <TextBlock x:Name="OwnedCountText" FontFamily="{StaticResource GtNum}" FontSize="24" Foreground="{StaticResource GtValue}" Margin="0 -2 0 0" />
        </StackPanel>
        <ScrollViewer x:Name="BrandScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0 30 24 44">
          <!-- Stretch＋MaxWidth = 国名 150＋タイル 238×5 の帯を中央に置き、段はその左端から（地域を切り替えても国名の位置が動かない）。
               6 社目からは段の中で折り返す -->
          <StackPanel x:Name="BrandGrid" HorizontalAlignment="Stretch" MaxWidth="1340" />
        </ScrollViewer>
        <TextBlock x:Name="HintBrandsBack" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="44 0 0 14" FontSize="12" Foreground="{StaticResource GtLabel}" />
        <TextBlock x:Name="HintBrands" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 44 14" FontSize="12" Foreground="{StaticResource GtLabel}" />
      </Grid>

      <!-- ══ ② 車の詳細（左=ロゴ・中=車・右=スペック / 下=そのメーカーの車の帯） ══ -->
      <!-- [fork] CarsRoot ごと、3D モードではショールームの上の透明窓へ引っ越す（BrandCentral.xaml.cs MoveCarsRoot）。
           2D（DLL 無し・brandcentral_2d.flag）ではこのページの中に留まり、中央に skins/preview の静止画を出す -->
      <Grid x:Name="CarsRoot">
      <Grid x:Name="CarsView" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="470" />
          </Grid.ColumnDefinitions>
          <!-- 3D モードの可読性スクリム（左=ロゴ/カータイプ・右=スペック）。クリックは抜ける -->
          <Border x:Name="LeftScrim" Grid.Column="0" Margin="0 0 -90 0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#8C000000" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border x:Name="RightScrim" Grid.Column="2" Margin="-170 0 0 0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#38000000" Offset="0.45" />
                <GradientStop Color="#70000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Image x:Name="BigBrandLogo" Grid.Column="0" Width="128" Height="128" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 40 0 0"
              RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="44 0 0 14">
            <TextBlock Text="カータイプ:" FontSize="11.5" Foreground="{StaticResource GtLabel}" />
            <TextBlock x:Name="CarTypeText" FontSize="12.5" Foreground="{StaticResource GtValue}" Margin="0 3 0 0" />
          </StackPanel>
          <Image x:Name="CarImg" Grid.Column="1" Stretch="Uniform" Margin="0 18 0 6" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock x:Name="PreviewNotice" Grid.Column="1" Visibility="Collapsed" FontSize="14" Foreground="#B8B8BC"
              Text="この車は3D表示に対応していないため、プレビューを表示しています　—　「ACで鑑賞」なら AC 本体で 3D で見られます"
              TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16 0 16 26" />
          <Border Grid.Column="2" Margin="0 44 58 8" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <c:CountryIcon x:Name="MakerFlag" Width="28" Height="19" VerticalAlignment="Center" Margin="0 0 10 0" />
                <TextBlock x:Name="MakerText" FontSize="17" Foreground="{StaticResource GtValue}" VerticalAlignment="Center" />
              </StackPanel>
              <!-- Keep the PP and table aligned when a car name takes two lines. -->
              <TextBlock x:Name="CarNameText" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0 8 0 0" Height="88" LineHeight="40" LineStackingStrategy="BlockLineHeight" />
              <!-- PP の右に価格（新車時の値段・円。Data\Static\gt7\car_prices.json・2026-10-17）。行を増やすと下のボタンがはみ出る -->
              <Grid Margin="0 22 0 0">
                <Border x:Name="PpPill" HorizontalAlignment="Left" BorderBrush="#AFAFB0" BorderThickness="1.5" CornerRadius="16" Padding="12 2 12 3">
                  <TextBlock x:Name="PpText" FontFamily="{StaticResource GtBody}" FontSize="18" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="PriceText" FontFamily="{StaticResource GtNum}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Rectangle Height="1" Fill="{StaticResource GtHair}" Opacity="0.8" Margin="0 16 0 12" />
              <StackPanel x:Name="SpecRows" />
              <Rectangle Height="1" Fill="{StaticResource GtHair}" Opacity="0.8" Margin="0 8 0 20" />
              <!-- ボディカラー: ‹ › か ↑↓ で選ぶ（2026-09-27） -->
              <Grid Margin="0 0 0 14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ボディカラー" FontSize="16" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Border x:Name="SkinPrev" Cursor="Hand" Background="Transparent" Padding="10 0 8 2" VerticalAlignment="Center" ToolTip="前の色（↑）">
                    <TextBlock Text="‹" FontSize="24" Foreground="{StaticResource GtValue}" />
                  </Border>
                  <StackPanel VerticalAlignment="Center" MaxWidth="250">
                    <TextBlock x:Name="SkinNameText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="SkinCountText" FontFamily="{StaticResource GtNum}" FontSize="11.5" Foreground="{StaticResource GtLabel}" HorizontalAlignment="Center" Margin="0 1 0 0" />
                  </StackPanel>
                  <Border x:Name="SkinNext" Cursor="Hand" Background="Transparent" Padding="8 0 0 2" VerticalAlignment="Center" ToolTip="次の色（↓）">
                    <TextBlock Text="›" FontSize="24" Foreground="{StaticResource GtValue}" />
                  </Border>
                </StackPanel>
              </Grid>
              <Grid x:Name="ZukanRow" Cursor="Hand" Background="Transparent" Margin="0 2 0 2">
                <TextBlock Text="クルマ図鑑" FontSize="16" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="ZukanState" Text="説明を読む" FontSize="16" Foreground="{StaticResource GtValue}" VerticalAlignment="Center" Margin="0 0 12 0" />
                  <TextBlock Text="📘" FontFamily="{StaticResource GtGlyph}" FontSize="23" Foreground="{StaticResource GtBlue}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <Grid Margin="0 16 0 0">
                <TextBlock Text="ガレージ" FontSize="16" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" />
                <TextBlock x:Name="OwnStateText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 22 0 0">
                <Border x:Name="SecondaryBtn" CornerRadius="20" BorderBrush="#9A9AA0" BorderThickness="1.5" Padding="26 7 26 9" Margin="0 0 12 0" Cursor="Hand" Background="Transparent">
                  <TextBlock x:Name="SecondaryText" Text="見てみる" FontSize="16" Foreground="{StaticResource GtValue}" />
                </Border>
                <Border x:Name="PrimaryBtn" CornerRadius="20" Background="#F2F2F4" BorderBrush="Transparent" BorderThickness="1.5" Padding="30 7 30 9" Cursor="Hand">
                  <TextBlock x:Name="PrimaryText" Text="ガレージに入れる" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1E" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <!-- Only the viewing area fades; header and car strip remain visible and usable. -->
        <Border x:Name="SwitchShade" Grid.Row="0" Panel.ZIndex="20" Background="Black" Opacity="0" Visibility="Collapsed" />
        <!-- 下: そのメーカーの車（横スクロールの帯。選択中=白枠） -->
        <Border x:Name="StripSurface" Grid.Row="1" Background="#18FFFFFF" BorderBrush="#16FFFFFF" BorderThickness="0 1 0 0">
          <ScrollViewer x:Name="StripScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnStripWheel">
            <StackPanel x:Name="CarStrip" Orientation="Horizontal" Margin="16 10 16 10" />
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="44 4 44 12">
          <TextBlock x:Name="HintCarsBack" FontSize="12" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" />
          <TextBlock x:Name="HintCars" FontSize="12" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </Grid>

      <!-- ══ 確認（GT7 の購入確認に相当。ここでは「ガレージに入れる」/「手放す」。決定後は納車完了の札） ══ -->
      <Grid x:Name="ConfirmOverlay" Visibility="Collapsed" Background="#B4000000" MouseLeftButtonUp="OnOverlayClick">
        <Border Width="720" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#35363C" CornerRadius="10" MouseLeftButtonUp="OnCardClick">
          <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" /></Border.Effect>
          <StackPanel>
            <Border Background="#42434A" CornerRadius="10 10 0 0" Padding="30 16 30 16">
              <StackPanel>
                <TextBlock x:Name="ConfirmTitle" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" />
                <TextBlock x:Name="ConfirmSub" FontSize="12.5" Foreground="#B8B8BC" Margin="0 5 0 0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Grid Height="300">
              <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.8">
                  <GradientStop Color="#3E3F45" Offset="0" />
                  <GradientStop Color="#232428" Offset="1" />
                </RadialGradientBrush>
              </Grid.Background>
              <Image x:Name="ConfirmImg" Stretch="Uniform" Margin="40 16 40 34" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="ConfirmCar" FontSize="14" Foreground="{StaticResource GtValue}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 10" />
            </Grid>
            <!-- 購入時のボディカラー選び（色を決めないと買えない・2026-10-17）＋価格 -->
            <Grid x:Name="ConfirmSkinRow" Margin="34 14 34 0" Visibility="Collapsed">
              <TextBlock Text="ボディカラー" FontSize="15" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="ConfirmSkinPrev" Cursor="Hand" Background="Transparent" Padding="10 0 10 2" VerticalAlignment="Center" ToolTip="前の色（↑）">
                  <TextBlock Text="‹" FontSize="26" Foreground="{StaticResource GtValue}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Width="280">
                  <TextBlock x:Name="ConfirmSkinName" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                  <TextBlock x:Name="ConfirmSkinCount" FontFamily="{StaticResource GtNum}" FontSize="11.5" Foreground="{StaticResource GtLabel}" HorizontalAlignment="Center" Margin="0 1 0 0" />
                </StackPanel>
                <Border x:Name="ConfirmSkinNext" Cursor="Hand" Background="Transparent" Padding="10 0 10 2" VerticalAlignment="Center" ToolTip="次の色（↓）">
                  <TextBlock Text="›" FontSize="26" Foreground="{StaticResource GtValue}" />
                </Border>
              </StackPanel>
              <TextBlock x:Name="ConfirmPrice" FontFamily="{StaticResource GtNum}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 14 0 20">
              <Border x:Name="ConfirmNo" CornerRadius="22" BorderBrush="#9A9AA0" BorderThickness="1.5" Padding="48 9 48 11" Margin="0 0 14 0" Cursor="Hand" Background="Transparent">
                <TextBlock x:Name="ConfirmNoText" Text="やめる" FontSize="14.5" Foreground="{StaticResource GtValue}" />
              </Border>
              <Border x:Name="ConfirmYes" CornerRadius="22" Background="#F2F2F4" Padding="48 9 48 11" Cursor="Hand" BorderThickness="1.5" BorderBrush="Transparent">
                <TextBlock x:Name="ConfirmYesText" Text="ガレージに入れる" FontSize="14.5" FontWeight="SemiBold" Foreground="#1A1A1E" />
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ══ クルマ図鑑（ui_car.json の説明文＝219 台日本語化済み） ══ -->
      <Grid x:Name="ZukanOverlay" Visibility="Collapsed" Background="#C8000000" MouseLeftButtonUp="OnOverlayClick">
        <Border Width="1100" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1E1F24" CornerRadius="10" MouseLeftButtonUp="OnCardClick">
          <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" /></Border.Effect>
          <Grid Margin="30 24 30 22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="440" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0 0 26 0">
              <Image x:Name="ZukanImg" Stretch="Uniform" Height="240" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="ZukanBrand" FontFamily="{StaticResource GtNum}" FontSize="12" Foreground="{StaticResource GtGold}" Margin="0 12 0 0" />
              <TextBlock x:Name="ZukanName" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" TextWrapping="Wrap" />
              <TextBlock x:Name="ZukanMeta" FontSize="11.5" Foreground="{StaticResource GtLabel}" Margin="0 6 0 0" TextWrapping="Wrap" />
            </StackPanel>
            <DockPanel Grid.Column="1">
              <TextBlock DockPanel.Dock="Top" Text="クルマ図鑑" FontSize="12" Foreground="{StaticResource GtLabel}" Margin="0 0 0 8" />
              <Border DockPanel.Dock="Bottom" Margin="0 14 0 0" HorizontalAlignment="Right">
                <Border x:Name="ZukanClose" CornerRadius="20" BorderBrush="#9A9AA0" BorderThickness="1.5" Padding="40 7 40 9" Cursor="Hand" Background="Transparent">
                  <TextBlock Text="閉じる" FontSize="13.5" Foreground="{StaticResource GtValue}" />
                </Border>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ZukanText" FontSize="14" Foreground="{StaticResource GtValue}" TextWrapping="Wrap" LineHeight="25" Margin="0 0 12 0" />
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
