<UserControl x:Class="AcManager.Pages.Gt.CourseEntry" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mui="http://firstfloorsoftware.com/ModernUI"
    xmlns:gt="clr-namespace:AcManager.Pages.Gt"
    mc:Ignorable="d" Loaded="OnLoaded" Unloaded="OnUnloaded" FocusVisualStyle="{x:Null}" Focusable="True" PreviewKeyDown="OnPreviewKeyDown"
    FontFamily="Yu Gothic UI, Segoe UI" mui:ModernFrame.KeepAlive="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="GtGold" Color="#D4B474" />
    <SolidColorBrush x:Key="GtIvory" Color="#E8E6E1" />
    <FontFamily x:Key="GtHead">Bahnschrift Light SemiCondensed, Yu Gothic UI Light</FontFamily>
    <FontFamily x:Key="GtNum">Bahnschrift SemiCondensed, Yu Gothic UI</FontFamily>
    <DropShadowEffect x:Key="GtTextShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.9" Color="#000000" />
  </UserControl.Resources>

  <DockPanel>
  <gt:GtHeader x:Name="HeaderBar" DockPanel.Dock="Top" />
  <Grid x:Name="Root" Background="#060E1C" ClipToBounds="True">
    <!-- 背景: コースのプレビューをぼかして敷く。時刻で色被り -->
    <Grid x:Name="BackdropBox" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="BackdropZoom" ScaleX="1.06" ScaleY="1.06" />
      </Grid.RenderTransform>
      <!-- [fork] ぼかし無し・鮮明な写真（要望 2026-08-24） -->
      <Image x:Name="Backdrop" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="1" />
    </Grid>
    <Rectangle x:Name="TimeTint" IsHitTestVisible="False" Opacity="0" Fill="#0A1430" />
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <!-- [fork] 暗幕を軽く（要望 2026-08-24「ちょっと暗くない？」） -->
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#78060E1C" Offset="0" />
          <GradientStop Color="#40060E1C" Offset="0.35" />
          <GradientStop Color="#10060E1C" Offset="0.7" />
          <GradientStop Color="#00060E1C" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle VerticalAlignment="Bottom" Height="220" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00060E1C" Offset="0" />
          <GradientStop Color="#88060E1C" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- 中央上: ロゴ / コース名 / モード名の3段縦積み（GT7 ref_3） -->
    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 26 0 0" IsHitTestVisible="False">
      <!-- [fork] 2026-09-27 ロゴだけにした（下のコース名は出さない）ので枠を広げた: 84x360 → 150x440（縦長のヤス・マリーナのロゴが小さくならない） -->
      <Image x:Name="TrackLogo" MaxHeight="150" MaxWidth="440" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
          HorizontalAlignment="Center" Visibility="Collapsed" Effect="{StaticResource GtTextShadow}" />
      <TextBlock x:Name="TrackTitle" Text="" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource GtHead}" FontSize="44"
          Foreground="#F2FFFFFF" Margin="0 10 0 0" Effect="{StaticResource GtTextShadow}" />
      <TextBlock x:Name="TrackMode" Text="" HorizontalAlignment="Center" FontFamily="{StaticResource GtNum}" FontSize="15"
          Foreground="#C0FFFFFF" Margin="0 8 0 0" Effect="{StaticResource GtTextShadow}" />
    </StackPanel>

    <!-- 本体: ステップの中身（配置は ShowStep がステップごとに決める） -->
    <Grid x:Name="StepHost" Margin="56 168 56 78">
      <Grid x:Name="StepContent" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="StepSlide" X="0" />
        </Grid.RenderTransform>
      </Grid>
    </Grid>

    <!-- 簡易セッティング（GT7 ref_6: クイックメニューの縦ダイアログ）。Sキーで開閉・外側クリックで閉じる -->
    <Grid x:Name="SettingOverlay" Visibility="Collapsed" Panel.ZIndex="45" Background="#B4000000" MouseLeftButtonUp="OnSettingOverlayClick">
      <Border Width="700" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14" Background="#F0202226"
          Padding="34 22 34 30" MouseLeftButtonUp="OnSettingDialogClick">
        <StackPanel x:Name="SettingBody" />
      </Border>
    </Grid>

    <!-- レースの設定（GT7 ref_8の設定グリッド簡易版）。レースモードのクイックメニューから開く -->
    <Grid x:Name="RaceOverlay" Visibility="Collapsed" Panel.ZIndex="46" Background="#B4000000" MouseLeftButtonUp="OnRaceOverlayClick">
      <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14" Background="#F0202226"
          Padding="34 22 34 30" MouseLeftButtonUp="OnSettingDialogClick">
        <StackPanel x:Name="RaceBody" />
      </Border>
    </Grid>

    <!-- ローディング画面（GT7 風: 黒地・中央上にコース名・下に車のガレージ画像・右下にスピナー） -->
    <Grid x:Name="LoadingScreen" Background="#000000" Visibility="Collapsed" Panel.ZIndex="50">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 120 0 0">
        <Image x:Name="LoadOutline" Height="120" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9" Margin="0 0 0 18" />
        <TextBlock x:Name="LoadTrackName" Text="" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource GtHead}" FontSize="58"
            Foreground="{StaticResource GtIvory}" TextWrapping="Wrap" MaxWidth="1100" />
        <TextBlock x:Name="LoadTrackSub" Text="" HorizontalAlignment="Center" FontFamily="{StaticResource GtNum}" FontSize="15" Foreground="{StaticResource GtGold}" Margin="0 6 0 0" />
      </StackPanel>
      <Grid VerticalAlignment="Bottom" Margin="64 0 64 56">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
          <Border Width="360" Height="202" Background="#14FFFFFF" CornerRadius="3" ClipToBounds="True">
            <Image x:Name="LoadCarImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel VerticalAlignment="Bottom" Margin="22 0 0 4">
            <TextBlock x:Name="LoadCarBrand" Text="" FontFamily="{StaticResource GtNum}" FontSize="13" Foreground="{StaticResource GtGold}" />
            <TextBlock x:Name="LoadCarName" Text="" FontFamily="{StaticResource GtHead}" FontSize="30" Foreground="{StaticResource GtIvory}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock x:Name="LoadStatus" Text="ロード中" FontFamily="{StaticResource GtNum}" FontSize="14" Foreground="{StaticResource GtIvory}" Opacity="0.8"
              VerticalAlignment="Center" Margin="0 0 16 0" />
          <mui:ModernProgressRing x:Name="LoadSpinner" IsActive="True" Width="34" Height="34" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- 下端: 中央=ステップ名ラベル（GT7の段階フロー共通の位置） -->
    <StackPanel x:Name="BottomBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 12" />
    <TextBlock x:Name="StepFootLabel" Text="" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 20"
        FontFamily="{StaticResource GtNum}" FontSize="14" Foreground="#E6FFFFFF" Effect="{StaticResource GtTextShadow}" />
    <TextBlock x:Name="HintLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32 0 0 18" FontFamily="{StaticResource GtNum}" FontSize="11"
        Foreground="{StaticResource GtGold}" Opacity="0.8" Effect="{StaticResource GtTextShadow}" Text="Esc  戻る" />
    <TextBlock x:Name="HintRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 32 18" FontFamily="{StaticResource GtNum}" FontSize="11"
        Foreground="{StaticResource GtGold}" Opacity="0.8" Effect="{StaticResource GtTextShadow}" Text="Enter  決定" />
  </Grid>
  </DockPanel>
</UserControl>
