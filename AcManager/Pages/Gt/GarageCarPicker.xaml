<Window x:Class="AcManager.Pages.Gt.GarageCarPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI"
    xmlns:gt="clr-namespace:AcManager.Pages.Gt" xmlns:c="clr-namespace:AcManager.Controls;assembly=AcManager.Controls"
    Title="CM7 乗り換え" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
    Background="#0E0E10" FontFamily="Yu Gothic UI, Segoe UI" PreviewKeyDown="OnKeyDown" Loaded="OnLoaded">
  <!-- [fork] GT7の「乗り換え」画面(実測: ref_7_garage_change_car_grid.png)。
       暗背景+6列カードグリッド。カード= PPピル(右上)/ブランドバッジ(左上)/車レンダー/車名(中央)/スペック行/国旗。
       選択中(=現在の車)とホバーだけ白1px枠。クリックで即乗り換え・Escで戻る -->
  <Window.Resources>
    <gt:GaragePpConverter x:Key="Pp" />
    <gt:GarageSpecConverter x:Key="Spec" />
  </Window.Resources>
  <DockPanel>
    <!-- GT7共通ヘッダー(原則: 施設内は常にヘッダーあり・要望 2026-08-25) -->
    <gt:GtHeader x:Name="Header" DockPanel.Dock="Top" />
    <!-- 上部バー(実測: 左に🔍+「すべてのクルマ」・台数、右に並び順) -->
    <Grid DockPanel.Dock="Top" Height="56" Background="#0E0E10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30 0 0 0">
        <Border Width="34" Height="34" CornerRadius="17" Background="#1E1E22" VerticalAlignment="Center">
          <TextBlock Text="🔍" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#C8C8CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Grid VerticalAlignment="Center" Margin="14 0 0 0" Width="240">
          <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="#F0F0F2"
              VerticalAlignment="Center" TextChanged="OnSearchChanged" CaretBrush="#F0F0F2" />
          <TextBlock x:Name="SearchHint" Text="ガレージのクルマ" FontSize="15" Foreground="#E6E6EA" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <TextBlock x:Name="CountText" Text="" FontSize="13" Foreground="#8A8A90" VerticalAlignment="Center" Margin="30 0 0 0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 34 0">
        <TextBlock Text="メーカー順" FontSize="13" Foreground="#B4B4BA" VerticalAlignment="Center" />
        <!-- [fork] 2026-09-06 レースで使えるのはガレージの車だけ。増やすのはブランドセントラルで -->
        <Button x:Name="GoBrandLink" Cursor="Hand" Background="Transparent" Margin="26 0 0 0" Padding="10 4 10 5" BorderBrush="#5A5A60" BorderThickness="1" Click="OnGoBrand"
            gt:GtSfx.HandlesClickSound="True" AutomationProperties.Name="ブランドセントラルでクルマを探す" ToolTip="パッド／ハンコンの△、または Tab で選んで Enter">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="BrandBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="14"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BrandBorder" Property="BorderBrush" Value="#D4B474" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BrandBorder" Property="BorderBrush" Value="White" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <TextBlock Text="🏬  ブランドセントラルでクルマを探す" FontSize="12.5" Foreground="#D4B474" VerticalAlignment="Center" />
        </Button>
        <TextBlock Text="矢印で選択  ·  Enterで決定  ·  Escで戻る" FontSize="12" Foreground="#8A8A90" VerticalAlignment="Center" Margin="26 0 0 0" />
      </StackPanel>
    </Grid>

    <!-- ListBox自身のScrollViewerに任せる(外側ScrollViewerで包むとマウスホイールが死ぬ・要望バグ報告 2026-08-25) -->
    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="12 4 12 24"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Width="298" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="8 6 8 8">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#1A1A1E" />
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#F0F0F2" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#17171B" />
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#D8D8DC" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="118" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
              </Grid.RowDefinitions>
              <!-- 上段: ブランドバッジ(左) / PPピル(右) -->
              <mui:BetterImage Filename="{Binding BrandBadge}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2 0 0 0" />
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#CC000000" CornerRadius="2" Padding="8 2 8 3">
                <TextBlock FontSize="11.5" Foreground="#F0F0F2" FontWeight="SemiBold">
                  <Run Text="PP " Foreground="#A0A0A6" /><Run Text="{Binding Converter={StaticResource Pp}, Mode=OneWay}" />
                </TextBlock>
              </Border>
              <!-- 車レンダー -->
              <mui:BetterImage Grid.Row="1" Filename="{Binding SelectedSkin.PreviewImage}" DecodeWidth="300" Margin="4" />
              <!-- 車名(中央・2行まで) -->
              <TextBlock Grid.Row="2" Text="{Binding DisplayName}" FontSize="13.5" Foreground="#F0F0F2" TextAlignment="Center"
                  TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="4 2 4 0" />
              <!-- スペック行 -->
              <TextBlock Grid.Row="3" Text="{Binding Converter={StaticResource Spec}, Mode=OneWay}" FontSize="11" Foreground="#8A8A90" TextAlignment="Center" Margin="0 3 0 0" />
              <!-- 最下段: 国旗+☆ -->
              <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="2 0 0 0">
                <c:CountryIcon Country="{Binding Country}" Width="20" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="☆" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="#5A5A60" VerticalAlignment="Center" Margin="10 0 0 0" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
