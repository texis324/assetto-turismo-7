<UserControl x:Class="AcManager.Pages.Gt.TuningShop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:gt="clr-namespace:AcManager.Pages.Gt"
    mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
    Focusable="True" KeyDown="OnKeyDown">
  <UserControl.Resources>
    <!-- [fork] GT7 チューニングショップ実測配色（gt7-ref/car_settings/ref_7_tuning_shop_parts_grid_4k.jpg）
         面 #2B2C30 / タブ帯 #D2D2D4（選択タブ=白） / カード画像面 #34353A→#1E1F23 / 名前帯 #1B1C20 / 価格帯 #2A2B30
         右パネル #1E1F24 / ラベル #8A8A8A / 値 #F0F0F0 / 変化後の値=青 #58A6F0 -->
    <SolidColorBrush x:Key="GtShopBg" Color="#2B2C30" />
    <SolidColorBrush x:Key="GtLabel" Color="#8A8A8A" />
    <SolidColorBrush x:Key="GtValue" Color="#F0F0F0" />
    <SolidColorBrush x:Key="GtHair" Color="#4A4C54" />
    <SolidColorBrush x:Key="GtBlue" Color="#58A6F0" />
    <SolidColorBrush x:Key="GtGreen" Color="#10A050" />
    <SolidColorBrush x:Key="GtCardName" Color="#1B1C20" />
    <SolidColorBrush x:Key="GtCardFoot" Color="#2A2B30" />
    <FontFamily x:Key="GtNum">Bahnschrift SemiCondensed, Yu Gothic UI</FontFamily>
    <FontFamily x:Key="GtBody">Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="GtGlyph">Segoe UI Emoji, Segoe UI Symbol</FontFamily>
  </UserControl.Resources>

  <Grid Background="{StaticResource GtShopBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- GT7共通ヘッダーバー -->
    <gt:GtHeader x:Name="Header" Grid.Row="0" />

    <!-- ══ 店の看板（GT7 のチューニングショップ「UNDERSTEER ENGINEERING」＝赤いドット地） ══ -->
    <Grid Grid.Row="1" Height="76">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#D2281E" Offset="0" />
          <GradientStop Color="#B81E16" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Rectangle Opacity="0.22">
        <Rectangle.Fill>
          <DrawingBrush TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
              <GeometryDrawing Brush="#000000">
                <GeometryDrawing.Geometry>
                  <EllipseGeometry Center="3.5,3.5" RadiusX="1.3" RadiusY="1.3" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Rectangle.Fill>
      </Rectangle>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 2">
        <TextBlock Text="UNDERSTEER" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="33" Foreground="#FFFFFF"
            HorizontalAlignment="Center" Margin="0 0 0 -4">
          <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.45" /></TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="E N G I N E E R I N G" FontFamily="Bahnschrift Light, Segoe UI" FontSize="10.5" Foreground="#F6D8D5" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- ══ カテゴリタブ（L1/R1 で切替） ══ -->
    <Grid Grid.Row="2" Height="52" Background="#D2D2D4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="TabPrev" Grid.Column="0" Margin="22 0 0 0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" Padding="6 4">
        <StackPanel Orientation="Horizontal">
          <Border Background="#C4231B" CornerRadius="3" Padding="7 1 7 2"><TextBlock Text="L1" FontFamily="{StaticResource GtNum}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" /></Border>
          <TextBlock Text="◀" FontSize="10" Foreground="#3A3A3E" VerticalAlignment="Center" Margin="8 0 0 0" />
        </StackPanel>
      </Border>
      <StackPanel x:Name="TabBar" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" />
      <Border x:Name="TabNext" Grid.Column="2" Margin="0 0 22 0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" Padding="6 4">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="▶" FontSize="10" Foreground="#3A3A3E" VerticalAlignment="Center" Margin="0 0 8 0" />
          <Border Background="#C4231B" CornerRadius="3" Padding="7 1 7 2"><TextBlock Text="R1" FontFamily="{StaticResource GtNum}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" /></Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══ 本体: 左=パーツグリッド / 右=車のカード ══ -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="GridScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <WrapPanel x:Name="PartsGrid" Margin="34 22 10 22" />
      </ScrollViewer>

      <Border Grid.Column="1" Width="440" Margin="6 22 36 22" Background="#1E1F24" CornerRadius="8" VerticalAlignment="Top">
        <StackPanel Margin="26 18 26 22">
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Image x:Name="BrandBadgeImg" Width="26" Height="26" VerticalAlignment="Center" Margin="0 0 10 0" />
              <TextBlock x:Name="BrandText" FontSize="13.5" Foreground="{StaticResource GtValue}" VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="PpPill" HorizontalAlignment="Right" BorderBrush="#AFAFB0" BorderThickness="1" CornerRadius="14" Padding="14 3 14 4">
              <TextBlock x:Name="PpText" FontFamily="{StaticResource GtNum}" FontSize="13.5" />
            </Border>
          </Grid>
          <Image x:Name="CarImg" Height="196" Margin="0 12 0 6" Stretch="Uniform" />
          <TextBlock x:Name="CarNameText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" TextWrapping="Wrap" FontFamily="{StaticResource GtBody}" />
          <Grid Margin="0 16 0 6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource GtHair}" VerticalAlignment="Center" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="スペック" FontSize="11.5" Foreground="{StaticResource GtLabel}" Margin="12 0 12 0" />
            <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource GtHair}" VerticalAlignment="Center" Opacity="0.7" />
          </Grid>
          <StackPanel x:Name="SpecRows" />
          <Grid Margin="0 16 0 6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource GtHair}" VerticalAlignment="Center" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="装着パーツ" FontSize="11.5" Foreground="{StaticResource GtLabel}" Margin="12 0 12 0" />
            <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource GtHair}" VerticalAlignment="Center" Opacity="0.7" />
          </Grid>
          <TextBlock x:Name="InstalledText" FontSize="11.5" Foreground="{StaticResource GtLabel}" TextWrapping="Wrap" LineHeight="18" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- フッター -->
    <Grid Grid.Row="4" Margin="44 4 44 14">
      <TextBlock x:Name="HintBack" Text="Esc  戻る" FontSize="12" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" />
      <TextBlock x:Name="HintTabs" Text="Q / E  カテゴリ" FontSize="12" Foreground="{StaticResource GtLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>

    <!-- ══ パーツ詳細（GT7: 中央の暗いカード。上=名前と一言、中=商品写真、下=ボタン） ══ -->
    <Grid x:Name="DetailOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#B4000000" MouseLeftButtonUp="OnOverlayClick">
      <Border Width="880" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#35363C" CornerRadius="10" MouseLeftButtonUp="OnDetailClick">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" /></Border.Effect>
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#42434A" CornerRadius="10 10 0 0" Padding="30 16 30 16">
            <StackPanel>
              <TextBlock x:Name="DetailName" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource GtValue}" FontFamily="{StaticResource GtBody}" />
              <TextBlock x:Name="DetailDesc" FontSize="12.5" Foreground="#B8B8BC" Margin="0 5 0 0" TextWrapping="Wrap" FontFamily="{StaticResource GtBody}" />
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="0 14 0 20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Border x:Name="DetailSecondary" CornerRadius="22" BorderBrush="#9A9AA0" BorderThickness="1.5" Padding="52 9 52 11" Margin="0 0 14 0" Cursor="Hand" Background="Transparent">
                <TextBlock x:Name="DetailSecondaryText" Text="やめる" FontSize="14.5" Foreground="{StaticResource GtValue}" FontFamily="{StaticResource GtBody}" />
              </Border>
              <Border x:Name="DetailPrimary" CornerRadius="22" Background="#F2F2F4" Padding="52 9 52 11" Cursor="Hand" BorderThickness="1.5" BorderBrush="Transparent">
                <TextBlock x:Name="DetailPrimaryText" Text="取り付ける" FontSize="14.5" FontWeight="SemiBold" Foreground="#1A1A1E" FontFamily="{StaticResource GtBody}" />
              </Border>
            </StackPanel>
          </Border>
          <Grid Height="430">
            <Grid.Background>
              <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.8">
                <GradientStop Color="#3E3F45" Offset="0" />
                <GradientStop Color="#232428" Offset="1" />
              </RadialGradientBrush>
            </Grid.Background>
            <Image x:Name="DetailImg" Stretch="Uniform" Margin="60 24 60 60" />
            <TextBlock x:Name="DetailGlyph" FontFamily="{StaticResource GtGlyph}" FontSize="150" Foreground="#E8E8EC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 30" Opacity="0.9" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 34 18">
              <TextBlock Text="PP" FontFamily="{StaticResource GtNum}" FontSize="15" Foreground="{StaticResource GtLabel}" VerticalAlignment="Bottom" Margin="0 0 10 5" />
              <TextBlock x:Name="DetailPpBefore" FontFamily="{StaticResource GtNum}" FontSize="24" Foreground="{StaticResource GtValue}" VerticalAlignment="Bottom" />
              <TextBlock x:Name="DetailPpArrow" Text="▶" FontSize="13" Foreground="{StaticResource GtBlue}" VerticalAlignment="Bottom" Margin="12 0 12 7" />
              <TextBlock x:Name="DetailPpAfter" FontFamily="{StaticResource GtNum}" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource GtBlue}" VerticalAlignment="Bottom" Margin="0 0 0 -3" />
            </StackPanel>
            <TextBlock x:Name="DetailNote" FontSize="12" Foreground="#F0B060" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34 0 0 22" />
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
